<?xml version="1.0"?>
<robot name="yunle_nav2" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Keep one source of truth for dimensions and sensor extrinsics. -->
  <xacro:include filename="$(find yunle_vehicle_description)/urdf/vehicle.xacro"/>
  <xacro:include filename="$(find livox_sensor_kit_description)/urdf/sensors.xacro"/>
</robot>
