diff --git a/src/launcher/autoware_launch/sensor_kit/sample_sensor_kit_launch/livox_sensor_kit_description/urdf/sensor_kit.xacro b/src/launcher/autoware_launch/sensor_kit/sample_sensor_kit_launch/livox_sensor_kit_description/urdf/sensor_kit.xacro
new file mode 100755
index 0000000..0099ba8
--- /dev/null
+++ b/src/launcher/autoware_launch/sensor_kit/sample_sensor_kit_launch/livox_sensor_kit_description/urdf/sensor_kit.xacro
@@ -0,0 +1,78 @@
+<?xml version="1.0"?>
+<robot xmlns:xacro="http://ros.org/wiki/xacro">
+  <xacro:macro name="sensor_kit_macro" params="parent x y z roll pitch yaw">
+    <xacro:include filename="$(find livox_sensor_kit_description)/sensor/imu/urdf/imu.xacro"/>
+
+    <xacro:arg name="config_dir" default="$(find livox_sensor_kit_description)/config"/>
+    <xacro:property name="sensor_kit_base_link" default="sensor_kit_base_link"/>
+    <xacro:property name="calibration" value="${xacro.load_yaml('$(arg config_dir)/sensor_kit_calibration.yaml')}"/>
+
+    <joint name="${sensor_kit_base_link}_joint" type="fixed">
+      <origin rpy="${roll} ${pitch} ${yaw}" xyz="${x} ${y} ${z}"/>
+      <parent link="${parent}"/>
+      <child link="${sensor_kit_base_link}"/>
+    </joint>
+    <link name="${sensor_kit_base_link}">
+      <origin rpy="0 0 0" xyz="0 0 0"/>
+    </link>
+
+    <!-- RealSense camera root frame; the camera driver publishes its child optical frames. -->
+    <joint name="camera0_link_joint" type="fixed">
+      <origin
+        xyz="${calibration['sensor_kit_base_link']['camera0_link']['x']}
+             ${calibration['sensor_kit_base_link']['camera0_link']['y']}
+             ${calibration['sensor_kit_base_link']['camera0_link']['z']}"
+        rpy="${calibration['sensor_kit_base_link']['camera0_link']['roll']}
+             ${calibration['sensor_kit_base_link']['camera0_link']['pitch']}
+             ${calibration['sensor_kit_base_link']['camera0_link']['yaw']}"
+      />
+      <parent link="${sensor_kit_base_link}"/>
+      <child link="camera0_link"/>
+    </joint>
+    <link name="camera0_link"/>
+
+    <!-- Livox Mid-360 LiDAR -->
+    <joint name="livox_front_base_link_joint" type="fixed">
+      <origin
+        xyz="${calibration['sensor_kit_base_link']['livox_front/livox_front_base_link']['x']}
+             ${calibration['sensor_kit_base_link']['livox_front/livox_front_base_link']['y']}
+             ${calibration['sensor_kit_base_link']['livox_front/livox_front_base_link']['z']}"
+        rpy="${calibration['sensor_kit_base_link']['livox_front/livox_front_base_link']['roll']}
+             ${calibration['sensor_kit_base_link']['livox_front/livox_front_base_link']['pitch']}
+             ${calibration['sensor_kit_base_link']['livox_front/livox_front_base_link']['yaw']}"
+      />
+      <parent link="${sensor_kit_base_link}"/>
+      <child link="livox_front/livox_front_base_link"/>
+    </joint>
+    <link name="livox_front/livox_front_base_link"/>
+
+    <!-- GNSS -->
+    <xacro:imu_macro
+      name="gnss"
+      parent="sensor_kit_base_link"
+      namespace=""
+      x="${calibration['sensor_kit_base_link']['gnss_link']['x']}"
+      y="${calibration['sensor_kit_base_link']['gnss_link']['y']}"
+      z="${calibration['sensor_kit_base_link']['gnss_link']['z']}"
+      roll="${calibration['sensor_kit_base_link']['gnss_link']['roll']}"
+      pitch="${calibration['sensor_kit_base_link']['gnss_link']['pitch']}"
+      yaw="${calibration['sensor_kit_base_link']['gnss_link']['yaw']}"
+      fps="100"
+    />
+    
+    <!-- IMU -->
+    <xacro:imu_macro
+      name="imu"
+      parent="sensor_kit_base_link"
+      namespace=""
+      x="${calibration['sensor_kit_base_link']['imu_link']['x']}"
+      y="${calibration['sensor_kit_base_link']['imu_link']['y']}"
+      z="${calibration['sensor_kit_base_link']['imu_link']['z']}"
+      roll="${calibration['sensor_kit_base_link']['imu_link']['roll']}"
+      pitch="${calibration['sensor_kit_base_link']['imu_link']['pitch']}"
+      yaw="${calibration['sensor_kit_base_link']['imu_link']['yaw']}"
+      fps="100"
+    />
+  
+  </xacro:macro>
+</robot>
