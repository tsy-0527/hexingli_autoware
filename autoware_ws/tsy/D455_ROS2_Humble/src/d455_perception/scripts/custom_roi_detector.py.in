#!@DETECTOR_PYTHON@
import os
import sys
import threading
import time
from pathlib import Path

import numpy as np

sys.path.append('/usr/lib/python3/dist-packages')
from ament_index_python.packages import get_package_share_directory
from autoware_perception_msgs.msg import DetectedObject, ObjectClassification
import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from sensor_msgs.msg import Image, RegionOfInterest
from tier4_perception_msgs.msg import (
    DetectedObjectWithFeature,
    DetectedObjectsWithFeature,
    Feature,
)


class CustomRoiDetector(Node):
    """Publish the trained three-class model as standard Autoware ROIs."""

    def __init__(self):
        super().__init__('custom_yolo_roi_detector')
        runtime = Path(get_package_share_directory('d455_perception')) / 'runtime'
        default_model = runtime / 'models' / 'best.pt'

        self.model_path = Path(self.declare_parameter(
            'model_path', str(default_model)).value)
        self.device = self.declare_parameter('device', 'cuda:0').value
        self.imgsz = int(self.declare_parameter('imgsz', 640).value)
        self.confidence = float(self.declare_parameter('confidence', 0.4).value)
        # Reject weak car predictions (e.g. corridor lights) before ROI merging.
        self.declare_parameter('car_confidence', 0.60)
        self.max_fps = float(self.declare_parameter('max_fps', 10.0).value)

        if self.imgsz <= 0:
            raise ValueError('imgsz must be positive')
        if not 0.0 < self.confidence <= 1.0:
            raise ValueError('confidence must be in (0, 1]')
        if self.max_fps <= 0.0:
            raise ValueError('max_fps must be positive')
        if not 0.0 < float(self.get_parameter('car_confidence').value) <= 1.0:
            raise ValueError('car_confidence must be in (0, 1]')
        if not self.model_path.is_file():
            raise FileNotFoundError(f'YOLO weights not found: {self.model_path}')

        sys.path.insert(0, str(runtime))
        self._runtime = runtime
        self._class_map = {
            'car': ObjectClassification.CAR,
            'shidunzi': ObjectClassification.UNKNOWN,
            'xingren': ObjectClassification.PEDESTRIAN,
        }

        self.publisher = self.create_publisher(
            DetectedObjectsWithFeature, '~/output/rois', 10)
        self.debug_image_publisher = self.create_publisher(
            Image, '~/debug/image_annotated', qos_profile_sensor_data)
        self.subscription = self.create_subscription(
            Image, '~/input/image', self.on_image, qos_profile_sensor_data)

        self._condition = threading.Condition()
        self._pending_image = None
        self._stop = False
        self._last_enqueue = 0.0
        self._detector = None
        self._worker = threading.Thread(
            target=self._inference_worker, name='custom_yolo_worker', daemon=True)
        self._worker.start()

        self.get_logger().info(
            f'Loading YOLO26s on {self.device} at imgsz={self.imgsz}. '
            'Initial model load/warm-up uses the GPU and may take several seconds.'
        )

    def on_image(self, image):
        now = time.monotonic()
        if now - self._last_enqueue < 1.0 / self.max_fps:
            return
        self._last_enqueue = now
        with self._condition:
            # Only the newest frame is retained. A slow detector never builds a backlog.
            self._pending_image = image
            self._condition.notify()

    def _image_to_bgr(self, msg):
        encodings = {
            'rgb8': 3,
            'bgr8': 3,
            'rgba8': 4,
            'bgra8': 4,
        }
        if msg.encoding not in encodings:
            raise ValueError(f'Unsupported image encoding: {msg.encoding}')
        channels = encodings[msg.encoding]
        row = np.frombuffer(msg.data, dtype=np.uint8).reshape(msg.height, msg.step)
        pixels = row[:, :msg.width * channels].reshape(
            msg.height, msg.width, channels)
        if msg.encoding == 'rgb8':
            return pixels[:, :, ::-1].copy()
        if msg.encoding == 'bgr8':
            return pixels.copy()
        if msg.encoding == 'rgba8':
            return pixels[:, :, [2, 1, 0]].copy()
        return pixels[:, :, [2, 1, 0]].copy()

    def _filter_detections(self, detections):
        car_threshold = float(self.get_parameter('car_confidence').value)
        return [
            detection for detection in detections
            if detection['class_name'] != 'car'
            or float(detection['confidence']) >= car_threshold
        ]

    def _make_roi_message(self, image_header, image_width, image_height, detections):
        message = DetectedObjectsWithFeature()
        message.header = image_header

        for detection in detections:
            class_name = detection['class_name']
            label = self._class_map.get(class_name)
            score = float(detection['confidence'])
            if label is None or not 0.0 < score <= 1.0:
                continue

            x1, y1, x2, y2 = detection['bbox_xyxy']
            x1 = int(np.clip(np.floor(x1), 0, image_width))
            y1 = int(np.clip(np.floor(y1), 0, image_height))
            x2 = int(np.clip(np.ceil(x2), 0, image_width))
            y2 = int(np.clip(np.ceil(y2), 0, image_height))
            if x2 <= x1 or y2 <= y1:
                continue

            feature_object = DetectedObjectWithFeature()
            feature_object.object = DetectedObject()
            feature_object.object.existence_probability = score
            feature_object.object.classification = [
                ObjectClassification(label=label, probability=score)
            ]
            feature_object.feature = Feature()
            feature_object.feature.roi = RegionOfInterest(
                x_offset=x1,
                y_offset=y1,
                width=x2 - x1,
                height=y2 - y1,
                do_rectify=False,
            )
            message.feature_objects.append(feature_object)
        return message

    def _inference_worker(self):
        try:
            os.environ.setdefault('YOLO_AUTOINSTALL', 'false')
            os.environ.setdefault('YOLO_OFFLINE', 'true')
            from bollard_detector import BollardDetector, draw_detections

            self._detector = BollardDetector(
                self.model_path,
                device=self.device,
                imgsz=self.imgsz,
                confidence=self.confidence,
            )
            self.get_logger().info(
                f'Custom YOLO ready: classes={self._detector.names}, '
                f'device={self.device}, imgsz={self.imgsz}'
            )
        except Exception as exc:
            self.get_logger().error(
                f'Custom YOLO initialization failed; built-in 7-class ROI remains active: {exc}'
            )
            return

        processed = 0
        errors = 0
        report_start = time.monotonic()
        while rclpy.ok() and not self._stop:
            with self._condition:
                while self._pending_image is None and not self._stop:
                    self._condition.wait(timeout=0.5)
                if self._stop:
                    break
                image = self._pending_image
                self._pending_image = None

            try:
                color = self._image_to_bgr(image)
                self._detector.confidence = float(
                    self.get_parameter('confidence').value)
                prediction = self._detector.predict_color(color)
                # Keep the debug overlay and fusion input consistent.
                prediction['detections'] = self._filter_detections(
                    prediction['detections'])
                self.publisher.publish(
                    self._make_roi_message(
                        image.header,
                        image.width,
                        image.height,
                        prediction['detections'],
                    ))
                if self.debug_image_publisher.get_subscription_count():
                    annotated = color.copy()
                    draw_detections(
                        annotated, prediction, (image.width, image.height))
                    self.debug_image_publisher.publish(Image(
                        header=image.header,
                        height=image.height,
                        width=image.width,
                        encoding='bgr8',
                        is_bigendian=False,
                        step=image.width * 3,
                        data=annotated.tobytes(),
                    ))
                processed += 1
            except Exception as exc:
                errors += 1
                self.get_logger().error(
                    f'Custom YOLO inference failed: {exc}',
                    throttle_duration_sec=3.0,
                )

            now = time.monotonic()
            if now - report_start >= 5.0:
                elapsed = now - report_start
                self.get_logger().info(
                    f'Custom YOLO: {processed / elapsed:.2f} Hz, errors={errors}'
                )
                processed = 0
                errors = 0
                report_start = now

    def stop(self):
        with self._condition:
            self._stop = True
            self._condition.notify()
        if self._worker.is_alive():
            self._worker.join(timeout=2.0)


def main():
    rclpy.init()
    node = None
    try:
        node = CustomRoiDetector()
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        if node is not None:
            node.stop()
            node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
